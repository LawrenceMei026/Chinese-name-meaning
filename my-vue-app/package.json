{
  "name": "my-vue-app",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:version && npm run check:dictionary-supplements && npm run check:xinhua-supplements && npm run check:unihan-supplements && npm run check:zhwiktionary-supplements && npm run check:name-meaning-coverage && npm run check:guangyun-data && npm run check:cultural-data && npm run check:tauri-acl && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:features": "node scripts/test-python-features.mjs && vitest --run src/__tests__/nameFeatures.spec.ts",
    "test:onnx": "node scripts/smoke-onnx.mjs",
    "verify": "run-s check:version check:dictionary-supplements check:xinhua-supplements check:unihan-supplements check:zhwiktionary-supplements check:name-meaning-coverage check:guangyun-data check:cultural-data check:tauri-acl test:features \"test:unit -- --run\" type-check lint:check test:onnx",
    "check:version": "node scripts/check-version.mjs",
    "check:dictionary-supplements": "node scripts/apply-dictionary-supplements.mjs --check",
    "check:xinhua-supplements": "node scripts/apply-xinhua-definition-supplements.mjs --check",
    "check:unihan-supplements": "node scripts/apply-unihan-definition-supplements.mjs --check",
    "check:name-meaning-coverage": "node scripts/check-name-meaning-coverage.mjs",
    "approve:global-name-meaning-review": "node scripts/approve-global-name-meaning-review.mjs",
    "check:zhwiktionary-supplements": "node scripts/apply-zhwiktionary-supplements.mjs --check",
    "check:guangyun-data": "node scripts/update-guangyun-data.mjs --check",
    "check:cultural-data": "node scripts/check-cultural-data.mjs",
    "check:tauri-acl": "node scripts/check-tauri-acl.mjs",
    "version": "node scripts/sync-version.mjs && npm run check:version",
    "update:dictionary-supplements": "node scripts/apply-dictionary-supplements.mjs",
    "generate:xinhua-supplements": "node scripts/generate-xinhua-definition-supplements.mjs",
    "update:xinhua-supplements": "node scripts/apply-xinhua-definition-supplements.mjs",
    "generate:unihan-supplements": "node scripts/generate-unihan-definition-supplements.mjs",
    "update:unihan-supplements": "node scripts/apply-unihan-definition-supplements.mjs",
    "update:zhwiktionary-supplements": "node scripts/apply-zhwiktionary-supplements.mjs",
    "generate:zhwiktionary-review-queue": "node scripts/generate-zhwiktionary-review-queue.mjs",
    "review:zhwiktionary-candidates": "node scripts/review-zhwiktionary-candidates.mjs",
    "import:zhwiktionary-auto-review": "node scripts/import-zhwiktionary-auto-review.mjs && npm run update:zhwiktionary-supplements",
    "approve:zhwiktionary-pending-review": "node scripts/approve-zhwiktionary-pending-review.mjs && npm run update:zhwiktionary-supplements",
    "check:zhwiktionary-candidate-review": "node scripts/review-zhwiktionary-candidates.mjs --check",
    "update:guangyun-data": "node scripts/update-guangyun-data.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:check": "run-p lint:check:oxlint lint:check:eslint",
    "lint:check:oxlint": "oxlint src scripts vite.config.ts eslint.config.ts",
    "lint:check:eslint": "eslint src scripts vite.config.ts eslint.config.ts",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "onnxruntime-web": "^1.20.1",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
